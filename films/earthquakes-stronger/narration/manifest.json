      "speech_end": 2.62,
      "hash": "b5fff1b68c3eb42c",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "11-m2",
      "text": "Minute two. Magnitude four.",
      "file": "11-m2.mp3",
      "align": "11-m2.align.json",
      "seconds": 2.8,
      "speech_start": 0.1,
      "speech_end": 2.32,
      "hash": "b5117cbe6235baa0",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "12-truck",
      "text": "It feels like a truck rumbling past. Locals barely look up.",
