      "seconds": 4.55,
      "speech_start": 0.06,
      "speech_end": 4.14,
      "hash": "da618e5ba122fdf4",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "13-long",
      "text": "But most earthquakes are over in a few seconds. This one has been going for a whole minute.",
