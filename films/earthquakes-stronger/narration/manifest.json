      "align": "08-x32.align.json",
      "seconds": 8.31,
      "speech_start": 0.12,
      "speech_end": 7.86,
      "hash": "80257eabc3ce248f",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "09-realtime",
      "text": "Everything you see from here on happens in real time.",
