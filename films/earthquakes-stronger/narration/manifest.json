      "speech_start": 0.06,
      "speech_end": 3.26,
      "hash": "8d91794590ea6033",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "10-cup",
      "text": "Nobody's noticed yet. Except your coffee.",
