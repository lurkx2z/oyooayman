      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "03-l_guilty",
      "text": "Only the guilty. Since I started, crime has dropped all over the world. Wars have stopped. People are finally afraid to do evil.",
      "file": "03-l_guilty.mp3",
      "align": "03-l_guilty.align.json",
