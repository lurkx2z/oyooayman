      "seconds": 11.18,
      "speech_start": 0.14,
      "speech_end": 10.6,
      "hash": "cd84e99440456dde",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "57-day",
      "text": "Step forty-six. On Earth, one whole day went by during that one step.",
      "file": "57-day.mp3",
      "align": "57-day.align.json",
      "seconds": 5.9,
      "speech_start": 0.14,
      "speech_end": 5.46,
      "hash": "9cde6483d46fb7a4",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "58-star",
      "text": "The Sun is just a bright star now.",
      "file": "58-star.mp3",
      "align": "58-star.align.json",
      "seconds": 2.95,
      "speech_start": 0.08,
      "speech_end": 2.24,
      "hash": "1669fec92120c3a8",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "59-month",
      "text": "Step fifty. On Earth, you've been gone for a month.",
      "file": "59-month.mp3",
      "align": "59-month.align.json",
      "seconds": 4.23,
      "speech_start": 0.14,
      "speech_end": 3.7,
      "hash": "1413da10c3c81db5",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "60-poster",
      "text": "Back home, there are posters up.",
      "file": "60-poster.mp3",
      "align": "60-poster.align.json",
      "seconds": 2.61,
      "speech_start": 0.08,
      "speech_end": 2.02,
      "hash": "58c289750e041243",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "61-ninemonths",
      "text": "Step fifty-three. Almost nine months.",
      "file": "61-ninemonths.mp3",
      "align": "61-ninemonths.align.json",
      "seconds": 3.74,
      "speech_start": 0.14,
      "speech_end": 3.06,
      "hash": "de19c18a9c1afd49",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "62-proxima",
      "text": "Step fifty-six. You pass Proxima Centauri, the closest star to the Sun.",
      "file": "62-proxima.mp3",
      "align": "62-proxima.align.json",
      "seconds": 5.83,
      "speech_start": 0.14,
      "speech_end": 5.38,
      "hash": "0101f5a84ddeda2f",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "63-sixyears",
      "text": "On Earth, almost six years have gone by.",
      "file": "63-sixyears.mp3",
      "align": "63-sixyears.align.json",
      "seconds": 3.34,
      "speech_start": 0.06,
      "speech_end": 2.9,
      "hash": "43f9671c5c3478c3",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "64-turn",
      "text": "And here's the strange part. Turn around now, and step fifty-seven would land you just behind your own front door.",
      "file": "64-turn.mp3",
      "align": "64-turn.align.json",
      "seconds": 7.26,
      "speech_start": 0.04,
      "speech_end": 6.86,
      "hash": "49a07f4d012081c4",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "65-eleven_years",
      "text": "Eleven years after you left.",
      "file": "65-eleven_years.mp3",
      "align": "65-eleven_years.align.json",
      "seconds": 2.53,
      "speech_start": 0.06,
      "speech_end": 1.94,
      "hash": "5dca5a1ea81646af",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "66-keep",
      "text": "You keep going.",
      "file": "66-keep.mp3",
      "align": "66-keep.align.json",
      "seconds": 1.59,
      "speech_start": 0.1,
      "speech_end": 0.98,
      "hash": "7c2c42d17f56cab5",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "67-sixty",
      "text": "Step sixty. Ninety years. Everyone you knew is gone.",
      "file": "67-sixty.mp3",
      "align": "67-sixty.align.json",
      "seconds": 5.36,
      "speech_start": 0.1,
      "speech_end": 4.74,
      "hash": "deb6196cb8777649",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "68-sixtyfour",
      "text": "Step sixty-four. Almost fifteen hundred years.",
      "file": "68-sixtyfour.mp3",
      "align": "68-sixtyfour.align.json",
      "seconds": 4.55,
      "speech_start": 0.14,
      "speech_end": 4,
      "hash": "44e4b6cf01a32a31",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "69-climb",
      "text": "Step sixty-seven. You're climbing out of the Milky Way.",
      "file": "69-climb.mp3",
      "align": "69-climb.align.json",
      "seconds": 3.89,
      "speech_start": 0.12,
      "speech_end": 3.36,
      "hash": "2aace91a200166f9",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "70-seventy",
      "text": "Step seventy. There it is. All of it. A few hundred billion stars. And every person who ever lived, lived in that one little spot.",
      "file": "70-seventy.mp3",
      "align": "70-seventy.align.json",
      "seconds": 10.63,
      "speech_start": 0.12,
      "speech_end": 10.14,
      "hash": "8f8da46dff49cb4c",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "71-humans",
      "text": "Step seventy-two. You've been gone longer than humans have existed.",
      "file": "71-humans.mp3",
      "align": "71-humans.align.json",
      "seconds": 4.78,
      "speech_start": 0.14,
      "speech_end": 4.44,
      "hash": "298edb88ad5b43dc",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "72-andromeda",
      "text": "Step seventy-five. You're farther from home than the Andromeda galaxy.",
      "file": "72-andromeda.mp3",
      "align": "72-andromeda.align.json",
      "seconds": 4.86,
      "speech_start": 0.14,
      "speech_end": 4.48,
      "hash": "07671b6b8141241a",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "73-dust",
      "text": "Step eighty. Galaxies everywhere, like dust.",
      "file": "73-dust.mp3",
      "align": "73-dust.align.json",
      "seconds": 4.62,
      "speech_start": 0.1,
      "speech_end": 3.92,
      "hash": "01bc246f321e2428",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "74-web",
      "text": "Step eighty-four. They hang in threads, around giant empty bubbles. Nobody has ever seen this from the outside.",
      "file": "74-web.mp3",
      "align": "74-web.align.json",
      "seconds": 8.62,
      "speech_start": 0.14,
      "speech_end": 8.039,
      "hash": "3cc9512c13290aa0",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "75-sundies",
      "text": "Step eighty-six. On Earth, six billion years have passed. The Sun has swollen into a red giant. It has probably swallowed the Earth.",
      "file": "75-sundies.mp3",
      "align": "75-sundies.align.json",
      "seconds": 10.55,
      "speech_start": 0.14,
      "speech_end": 9.88,
      "hash": "7906f247bd683814",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "76-ninety",
      "text": "Step ninety. You've gone farther than the whole observable universe is wide.",
      "file": "76-ninety.mp3",
      "align": "76-ninety.align.json",
      "seconds": 5.36,
      "speech_start": 0.14,
      "speech_end": 4.9,
      "hash": "061a1240a1ab532a",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "77-last",
      "text": "You can still turn around. Your next step would land you just behind where your front door used to be.",
      "file": "77-last.mp3",
      "align": "77-last.align.json",
      "seconds": 5.83,
      "speech_start": 0.08,
      "speech_end": 5.38,
      "hash": "66ad7fe0a59d6bb3",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "78-or",
      "text": "Or you could take step ninety-one.",
      "file": "78-or.mp3",
      "align": "78-or.align.json",
      "seconds": 2.87,
      "speech_start": 0.1,
      "speech_end": 2.3,
      "hash": "29bd325891f0c784",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "79-question",
      "text": "Which way would you step?",
      "file": "79-question.mp3",
      "align": "79-question.align.json",
      "seconds": 1.52,
      "speech_start": 0.08,
      "speech_end": 1.22,
      "hash": "da2a9ab5a05a63a3",
