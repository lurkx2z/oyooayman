      "speech_start": 0.06,
      "speech_end": 3,
      "hash": "2a7194cc86054594",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "52-sun",
      "text": "Step thirty-nine. Longer than the trip from the Earth to the Sun. Light needs eight minutes for that. You needed one second.",
