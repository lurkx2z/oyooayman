      "speech_start": 0.12,
      "speech_end": 7.04,
      "hash": "bc78319312f4624e",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "50-mars",
      "text": "Step thirty-seven. Fifty million kilometres. About as far as Mars, at its closest.",
