      "seconds": 5.02,
      "speech_start": 0.14,
      "speech_end": 4.82,
      "hash": "a57afe8d7af58af7",
      "verified": true,
      "timing": "forced-alignment"
    },
    {
      "id": "54-saturn",
      "text": "Step forty-two. Farther than Saturn.",
